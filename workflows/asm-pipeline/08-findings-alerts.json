      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "2108083d-bf38-41fa-a839-dd6348893cbc",
      "name": "New Findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('When Called').first().json;\nlet all = [];\ntry {\n  all = JSON.parse($('Read Findings').first().json.stdout || '[]');\n} catch (e) {\n  throw new Error(`Findings file did not parse: ${e.message}`);\n}\nconst known = new Set($input.all().map((i) => i.json.finding_key).filter(Boolean));\nconst fresh = all.filter((f) => f.finding_key && !known.has(f.finding_key));\nreturn [{ json: { engagement: ctx.engagement, run_id: ctx.run_id, total: all.length, findings: fresh } }];\n"
      }
    },
    {
      "id": "3ddb5d0f-d971-43bf-9bad-6936c7372bc6",
      "name": "Any New Findings?",
      "type": "n8n-nodes-base.if",

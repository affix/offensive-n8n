      "name": "Load Known Findings",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        400
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "DATA_TABLE_asm_findings",
          "cachedResultName": "asm_findings"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "engagement",
              "condition": "eq",
              "keyValue": "={{ $('When Called').first().json.engagement }}"
            }

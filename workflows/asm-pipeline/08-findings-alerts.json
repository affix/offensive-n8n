    {
      "id": "20e6be06-8c76-43ad-8529-d53e657b625f",
      "name": "Alert Embeds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RANK = { critical: 4, high: 3, medium: 2, low: 1, info: 0, unknown: -1 };\nconst COLOUR = { critical: 0x9B111E, high: 0xE74C3C, medium: 0xF39C12, low: 0x3498DB, info: 0x95A5A6, unknown: 0x7F8C8D };\nconst MAX_HOSTS = 20;\nconst cut = (s, n) => { s = String(s ?? ''); return s.length > n ? s.slice(0, n - 1) + '…' : s; };\nconst code = (s) => '`' + String(s).replace(/`/g, \"'\") + '`';\nconst title = (s) => s.charAt(0).toUpperCase() + s.slice(1);\n\nconst alertable = $input.all().map((i) => i.json)\n  .filter((f) => (RANK[f.severity] ?? -1) >= RANK.medium || f.source === 'takeover');\n\nconst hosts = new Map();\nfor (const f of alertable) {\n  const h = f.host || 'unknown-host';\n  if (!hosts.has(h)) hosts.set(h, []);\n  hosts.get(h).push(f);\n}\n\nconst ranked = [...hosts.entries()]\n  .map(([host, fs]) => ({ host, fs, worst: fs.reduce((w, f) => ((RANK[f.severity] ?? -1) > (RANK[w] ?? -1) ? f.severity : w), 'unknown') }))\n  .sort((a, b) => (RANK[b.worst] ?? -1) - (RANK[a.worst] ?? -1));\n\nreturn ranked.slice(0, MAX_HOSTS).map(({ host, fs, worst }) => {\n  const f0 = fs[0];\n  const lines = fs\n    .sort((a, b) => (RANK[b.severity] ?? -1) - (RANK[a.severity] ?? -1))\n    .slice(0, 8)\n    .map((f) => `• **${cut(f.name || f.template_id, 70)}** · ${title(f.severity)} · ${f.source}\\n  ${code(cut(f.matched_at || f.url, 150))}`)\n    .join('\\n');\n  const notes = fs\n    .filter((f) => f.triage_note && !/^(triage unavailable|triage output unparseable|not triaged)/.test(f.triage_note))\n    .slice(0, 4)\n    .map((f) => `• ${cut(f.template_id, 40)}: ${cut(f.triage_note, 160)}${f.triage_fp_likelihood != null ? ` (FP ${f.triage_fp_likelihood}%)` : ''}`)\n    .join('\\n');\n  const fields = [\n    { name: 'Engagement', value: code(f0.engagement), inline: true },\n    { name: 'Worst severity', value: title(worst), inline: true },\n    { name: 'New findings', value: String(fs.length), inline: true },\n    { name: 'What matched', value: cut(lines, 1024) }\n  ];\n  if (notes) fields.push({ name: 'Triage (local LLM, advisory)', value: cut(notes, 1024) });\n  fields.push({ name: 'Evidence', value: cut([...new Set(fs.map((f) => code(f.evidence_dir)))].join('\\n'), 1024) });\n  return { json: { host, embed: {\n    title: cut(`🎯 ${fs.length} new finding${fs.length === 1 ? '' : 's'} · ${host}`, 256),\n    color: COLOUR[worst] ?? COLOUR.unknown,\n    fields,\n    footer: { text: `ASM · ${f0.engagement} · ${f0.run_id}` },\n    timestamp: f0.seen_at\n  } } };\n});\n"
      }
    },

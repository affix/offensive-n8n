    {
      "id": "7218ece7-72d7-45a9-96f6-f2ad3a0e261b",
      "name": "Read Findings",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        400
      ],
      "parameters": {
        "executeOnce": true,
        "command": "=D='{{ $json.run_dir }}/findings'\ncase \"$D\" in /opt/loot/asm/*/*/findings) ;; *) echo 'bad path' >&2; exit 1;; esac\nif ls \"$D\"/*.jsonl >/dev/null 2>&1; then cat \"$D\"/*.jsonl | jq -s -c 'map(select(.finding_key)) | unique_by(.finding_key) | .[:500]'; else echo '[]'; fi"
      }
    },
    {

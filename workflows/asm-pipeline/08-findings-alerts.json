{
  "id": "EkqKNwqoMzw0Cdby",
  "name": "ASM · 08 Findings & Alerts",
  "description": "Collects findings/*.jsonl for the run, keeps only keys not already in asm_findings, triages via Ollama, records them, and alerts Discord per host (medium+ or takeover).",
  "active": true,
  "nodes": [

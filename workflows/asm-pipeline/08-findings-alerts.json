    {
      "id": "26eaca4a-0255-4493-a192-01532cdac52a",
      "name": "Return Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RANK = { critical: 4, high: 3, medium: 2, low: 1, info: 0, unknown: -1 };\nconst ctx = $('When Called').first().json;\nconst nf = $('New Findings').first().json;\nconst alertable = nf.findings.filter((f) => (RANK[String(f.severity).toLowerCase()] ?? -1) >= RANK.medium || f.source === 'takeover').length;\nconst bySev = {};\nfor (const f of nf.findings) {\n  const s = String(f.severity || 'unknown').toLowerCase();\n  bySev[s] = (bySev[s] ?? 0) + 1;\n}\nconst stages = { ...(ctx.stages ?? {}), findings: { total: nf.total, new: nf.findings.length, alertable, by_severity: bySev } };\nreturn [{ json: { ...ctx, stages } }];\n"
      }
    }

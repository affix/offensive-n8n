    {
      "id": "288369df-46bb-4dea-adcb-a5a77c3af4cd",
      "name": "Finding Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const nf = $('New Findings').first().json;\nconst t = $input.first().json?.triage ?? {};\nconst now = new Date().toISOString();\nreturn nf.findings.map((f) => {\n  const tr = t[f.finding_key] ?? { fp_likelihood: null, note: 'not triaged (over per-run cap)' };\n  return { json: {\n    finding_key: f.finding_key,\n    engagement: nf.engagement,\n    run_id: nf.run_id,\n    source: f.source || '',\n    host: f.host || '',\n    url: String(f.url || '').slice(0, 1000),\n    template_id: f.template_id || '',\n    name: String(f.name || '').slice(0, 300),\n    severity: String(f.severity || 'unknown').toLowerCase(),\n    matched_at: String(f.matched_at || '').slice(0, 1000),\n    evidence_dir: f.evidence_dir || '',\n    status: 'new',\n    triage_fp_likelihood: tr.fp_likelihood,\n    triage_note: tr.note,\n    detail: String(f.detail || '').slice(0, 600),\n    seen_at: now\n  } };\n});\n"
      }
    },

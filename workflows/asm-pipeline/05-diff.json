      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('When Called').first().json;\nconst rows = JSON.parse($input.first().json.stdout || '[]');\nconst now = new Date().toISOString();\nreturn rows.map((d) => ({ json: {\n  asset_key: d.asset_key,\n  engagement: ctx.engagement,\n  change: d.change,\n  kind: d.kind,\n  host: d.host || '',\n  ip: d.ip || '',\n  port: Number(d.port) || 0,\n  service: String(d.service || '').slice(0, 200),\n  url: d.url || '',\n  status_code: Number(d.status_code) || 0,\n  title: String(d.title || '').slice(0, 200),\n  tech: d.tech || '',\n  fingerprint: d.fingerprint || '',\n  run_id: ctx.run_id,\n  seen_at: now\n} }));\n"
      }

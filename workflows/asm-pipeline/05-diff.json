        300
      ],
      "parameters": {
        "command": "=R='{{ $('When Called').first().json.run_dir }}'\ncase \"$R\" in /opt/loot/asm/*/2*Z-*) ;; *) echo 'bad run dir' >&2; exit 1;; esac\nST=\"${R%/*}/state\"\nmkdir -p \"$ST\"\nif [ -s \"$R/ports/services.jsonl\" ]; then\n  { if [ -s \"$ST/services.json\" ]; then cat \"$ST/services.json\"; else echo '{}'; fi; jq -s 'map({key: \"\\(.ip):\\(.port)\", value: .}) | from_entries' \"$R/ports/services.jsonl\"; } | jq -s 'add' > \"$ST/services.json.tmp\" && mv \"$ST/services.json.tmp\" \"$ST/services.json\"\nfi\nif [ -s \"$R/web/web.jsonl\" ]; then cp \"$R/web/web.jsonl\" \"$ST/web_latest.jsonl.tmp\" && mv \"$ST/web_latest.jsonl.tmp\" \"$ST/web_latest.jsonl\"; fi\njq -nc --arg s \"$(jq 'length' \"$ST/services.json\" 2>/dev/null || echo 0)\" '{services_state: $s}' ",
        "executeOnce": true
      },
      "onError": "continueRegularOutput"
    }

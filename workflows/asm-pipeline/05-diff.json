    {
      "id": "722b816a-1f2d-4c07-9be6-412766f9c466",
      "name": "Build Diff Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const STAGE = 'diff';\nconst MAX_MINUTES = 30;\nconst BODY = \"mkdir -p \\\"$STATE\\\"\\npython3 - \\\"$R\\\" \\\"$STATE\\\" \\\"$ENG\\\" \\\"$RUN_ID\\\" <<'PY'\\nimport json, os, sys\\nfrom pathlib import Path\\nR, ST, eng, run_id = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3], sys.argv[4]\\n\\ndef jl(p):\\n    p = Path(p)\\n    if not p.exists():\\n        return []\\n    out = []\\n    for line in p.read_text().splitlines():\\n        try:\\n            out.append(json.loads(line))\\n        except ValueError:\\n            pass\\n    return out\\n\\ndef atomic(p, text):\\n    tmp = p.with_suffix(p.suffix + \\\".tmp\\\")\\n    tmp.write_text(text)\\n    os.replace(tmp, p)\\n\\nknown_ports = set((ST / \\\"ports.txt\\\").read_text().split()) if (ST / \\\"ports.txt\\\").exists() else set()\\nknown_web = json.loads((ST / \\\"web.json\\\").read_text()) if (ST / \\\"web.json\\\").exists() else {}\\nbaseline = not known_ports and not known_web\\nopen_ports = set((R / \\\"ports/open.txt\\\").read_text().split()) if (R / \\\"ports/open.txt\\\").exists() else set()\\nservices = {f\\\"{s['ip']}:{s['port']}\\\": s for s in jl(R / \\\"ports/services.jsonl\\\")}\\nweb = jl(R / \\\"web/web.jsonl\\\")\\nweb_ipports = {f\\\"{w['ip']}:{w['port']}\\\" for w in web}\\n\\ndelta = []\\nfor ipport in sorted(open_ports - known_ports):\\n    ip, _, port = ipport.rpartition(\\\":\\\")\\n    s = services.get(ipport, {})\\n    svc = \\\" \\\".join(x for x in [s.get(\\\"service\\\", \\\"\\\"), s.get(\\\"product\\\", \\\"\\\"), s.get(\\\"version\\\", \\\"\\\")] if x)\\n    delta.append({\\\"kind\\\": \\\"port\\\", \\\"change\\\": \\\"new\\\", \\\"asset_key\\\": f\\\"{eng}|port|{ipport}\\\", \\\"host\\\": \\\"\\\", \\\"ip\\\": ip,\\n                  \\\"port\\\": int(port), \\\"service\\\": svc, \\\"url\\\": \\\"\\\", \\\"status_code\\\": 0, \\\"title\\\": \\\"\\\", \\\"tech\\\": \\\"\\\",\\n                  \\\"fingerprint\\\": \\\"\\\", \\\"is_web\\\": ipport in web_ipports})\\nfor w in web:\\n    prev = known_web.get(w[\\\"url\\\"])\\n    if prev == w[\\\"fingerprint\\\"]:\\n        continue\\n    delta.append({\\\"kind\\\": \\\"web\\\", \\\"change\\\": \\\"new\\\" if prev is None else \\\"changed\\\", \\\"asset_key\\\": f\\\"{eng}|web|{w['url']}\\\",\\n                  \\\"host\\\": w[\\\"host\\\"], \\\"ip\\\": w[\\\"ip\\\"], \\\"port\\\": w[\\\"port\\\"], \\\"service\\\": w.get(\\\"server\\\", \\\"\\\"), \\\"url\\\": w[\\\"url\\\"],\\n                  \\\"status_code\\\": w[\\\"status_code\\\"], \\\"title\\\": w[\\\"title\\\"], \\\"tech\\\": \\\", \\\".join(w[\\\"tech\\\"])[:300],\\n                  \\\"fingerprint\\\": w[\\\"fingerprint\\\"], \\\"is_web\\\": True})\\n\\nwith open(\\\"delta.jsonl\\\", \\\"w\\\") as fh:\\n    for d in delta:\\n        fh.write(json.dumps(d) + \\\"\\\\n\\\")\\nweb_urls = sorted({d[\\\"url\\\"] for d in delta if d[\\\"kind\\\"] == \\\"web\\\"})\\nnet = sorted({f\\\"{d['ip']}:{d['port']}\\\" for d in delta if d[\\\"kind\\\"] == \\\"port\\\" and not d[\\\"is_web\\\"]})\\nPath(\\\"delta_web.txt\\\").write_text(\\\"\\\".join(f\\\"{u}\\\\n\\\" for u in web_urls))\\nPath(\\\"delta_net.txt\\\").write_text(\\\"\\\".join(f\\\"{n}\\\\n\\\" for n in net))\\n\\nknown_web.update({w[\\\"url\\\"]: w[\\\"fingerprint\\\"] for w in web})\\natomic(ST / \\\"web.json\\\", json.dumps(known_web))\\natomic(ST / \\\"ports.txt\\\", \\\"\\\".join(f\\\"{p}\\\\n\\\" for p in sorted(known_ports | open_ports)))\\n\\nsummary = {\\\"baseline\\\": baseline, \\\"ports_open\\\": len(open_ports), \\\"web_live\\\": len(web),\\n           \\\"assets_new\\\": sum(1 for d in delta if d[\\\"change\\\"] == \\\"new\\\"),\\n           \\\"assets_changed\\\": sum(1 for d in delta if d[\\\"change\\\"] == \\\"changed\\\"),\\n           \\\"delta_web\\\": len(web_urls), \\\"delta_net\\\": len(net), \\\"delta_total\\\": len(delta)}\\nPath(\\\"result.json\\\").write_text(json.dumps(summary))\\nPY\\n\";\nconst c = $input.first().json;\nconst SAFE = /^[A-Za-z0-9_.\\/:-]+$/;\nconst q = (k) => {\n  const v = String(c[k] ?? '');\n  if (!SAFE.test(v)) throw new Error(`Unsafe or missing context value for ${k}: ${v}`);\n  return `'${v}'`;\n};\nconst int = (v, lo, hi, d) => Math.min(Math.max(parseInt(v ?? d, 10) || d, lo), hi);\nconst header = [\n  '#!/usr/bin/env bash',\n  'set -uo pipefail',\n  `R=${q('run_dir')}`,\n  `S=${q('run_dir').slice(0, -1)}/${STAGE}'`,\n  `ENG=${q('engagement')}`,\n  `RUN_ID=${q('run_id')}`,\n  `STATE=${q('state_dir')}`,\n  `RATE=${int(c.rate, 1, 500, 50)}`,\n  `PORT_RATE=${int(c.port_rate, 50, 2000, 500)}`,\n  `INTRUSIVE=${c.intrusive === true ? 1 : 0}`,\n  `PERMUTE=${c.permute === true ? 1 : 0}`,\n  'mkdir -p \"$S\" && cd \"$S\" || exit 1',\n  ''\n].join('\\n');\nreturn [{ json: { job_dir: `${c.run_dir}/${STAGE}`, script: header + BODY, max_minutes: MAX_MINUTES } }];\n"
      }
    },

{
  "id": "uGoTm9hPm0iJzU2G",
  "name": "ASM · 05 Diff",
  "description": "Stage 5: diffs open ports and web fingerprints against on-disk state, writes delta target lists for Vuln, upserts new/changed assets into asm_assets.",
  "active": true,
  "nodes": [
    {
      "id": "31539d09-baf2-4c46-9ce3-d919ad337516",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "passthrough"
      }

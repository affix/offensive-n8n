    {
      "id": "a0bb089b-85b8-4084-9236-b5211a72613d",
      "name": "Evaluate Expiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const WARN_DAYS = 3;\nconst day = (v) => { const d = v ? new Date(v) : null; return d && !Number.isNaN(d.getTime()) ? d.toISOString().slice(0, 10) : null; };\nconst today = new Date().toISOString().slice(0, 10);\nconst daysUntil = (d) => Math.round((Date.parse(d) - Date.parse(today)) / 864e5);\n\nconst groups = new Map();\nfor (const { json: r } of $input.all()) {\n  if (!r.engagement || r.enabled !== true) continue;\n  const eng = String(r.engagement).trim().toLowerCase();\n  if (!groups.has(eng)) groups.set(eng, []);\n  groups.get(eng).push(r);\n}\n\nconst expired = [], expiring = [], undated = [];\nfor (const [eng, rs] of groups) {\n  const end = rs.map((r) => day(r.scope_end)).filter(Boolean).sort()[0] ?? null;\n  if (!end) { undated.push(eng); continue; }\n  const left = daysUntil(end);\n  if (left < 0) expired.push({ engagement: eng, scope_end: end, rows: rs.length });\n  else if (left <= WARN_DAYS) expiring.push({ engagement: eng, scope_end: end, days_left: left });\n}\nreturn [{ json: { today, expired, expiring, undated, monday: new Date().getUTCDay() === 1 } }];\n"
      }
    },
    {
      "id": "9d3ea9bc-77bf-4a8c-a694-91f4dc514dd1",
      "name": "Expired Engagements",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,

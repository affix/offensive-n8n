        "include": "noOtherFields"
      }
    },
    {
      "id": "9409a201-e26b-41c3-9e65-6102b579e09d",
      "name": "Disable Scope Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        900,
        160
      ],
      "parameters": {

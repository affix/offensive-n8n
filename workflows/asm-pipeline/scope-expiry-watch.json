    {
      "id": "ab1bc992-21b8-460b-9643-4e13ceea8d6e",
      "name": "Expiry Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $('Evaluate Expiry').first().json;\nif (!r.expired.length && !r.expiring.length && !(r.monday && r.undated.length)) return [];\nconst code = (s) => '`' + s + '`';\nconst fields = [];\nif (r.expired.length) fields.push({ name: 'Expired and disabled', value: r.expired.map((e) => `${code(e.engagement)} ended ${e.scope_end} (${e.rows} rows disabled)`).join('\\n').slice(0, 1024) });\nif (r.expiring.length) fields.push({ name: 'Expiring soon', value: r.expiring.map((e) => `${code(e.engagement)} ends ${e.scope_end} (${e.days_left === 0 ? 'today' : `${e.days_left}d`})`).join('\\n').slice(0, 1024) });\nif (r.monday && r.undated.length) fields.push({ name: 'Enabled with no scope_end', value: r.undated.map(code).join(', ').slice(0, 1024) });\nreturn [{ json: { embed: {\n  title: r.expired.length ? '⛔ ASM scope expired' : '⏳ ASM scope ending soon',\n  color: r.expired.length ? 0x9B111E : 0xF39C12,\n  fields,\n  footer: { text: 'ASM · Scope Expiry Watch' },\n  timestamp: new Date().toISOString()\n} } }];\n"
      }
    },

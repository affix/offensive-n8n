{
  "id": "ctxZWf9JE5GOKtvE",
  "name": "Subdomain Takeover Monitor",
  "description": "Every 4 hours: read in-scope roots, split them into at most 3 lanes and start one Subdomain Takeover Scan execution per lane.",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "operation": "get",

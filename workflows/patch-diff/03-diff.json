    {
      "id": "aad22fbd-e8e4-4180-a583-464f1339bbfb",
      "name": "Build Diff Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const STAGE = 'diff';\nconst c = $input.first().json;\nconst SAFE = /^[A-Za-z0-9_.\\/:+~-]+$/;\nfor (const k of ['run_dir', 'product', 'old_version', 'new_version']) {\n  if (!SAFE.test(String(c[k] ?? ''))) throw new Error(`Unsafe or missing context value for ${k}: ${c[k]}`);\n}\nconst job_dir = `${c.run_dir}/${STAGE}`;\nconst q = (v) => `'${v}'`;\nconst script = [\n  '#!/usr/bin/env bash',\n  'set -euo pipefail',\n  `exec /opt/patchdiff/bin/pd ${STAGE} --job-dir ${q(job_dir)} --product ${q(c.product)} --old ${q(c.old_version)} --new ${q(c.new_version)}`,\n  ''\n].join('\\n');\nreturn [{ json: { job_dir, script, remote_host: c.remote_host ?? '', max_minutes: (c.limits ?? {})[STAGE] ?? 240 } }];\n"
      }
    },
    {
      "id": "2ac6cfa1-6852-4175-9cb5-c4e1366ef407",

    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "DATA_TABLE_pd_watch",
          "cachedResultName": "pd_watch"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "product",
              "keyValue": "={{ $json.product }}"
            }
          ]

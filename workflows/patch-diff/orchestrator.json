{
  "id": "hUHnI3j2uAPi0YFs",
  "name": "PD · Orchestrator",
  "description": "PD pipeline for one product: per-product lock, run dir + config.json, then Fetch, Unpack, Diff, Triage, Alerts via the PD Job Runner; records pd_runs/pd_versions.",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "product"
            },
            {
              "name": "old_version"
            },
            {
              "name": "new_version"
            },
            {
              "name": "trigger"
            }
          ]
        }
      },
      "id": "a0296d81-d212-41e2-a878-081b6af9f391",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst product = String(j.product ?? '').trim().toLowerCase();\nconst oldV = String(j.old_version ?? '').trim();\nconst newV = String(j.new_version ?? '').trim();\nconst trigger = j.trigger ? String(j.trigger) : (j.submittedAt ? 'form' : 'manual');\nif (!/^[a-z0-9][a-z0-9_-]{0,39}$/.test(product) || product === 'pd-sys') throw new Error(`Invalid product: ${product}`);\nfor (const v of [oldV, newV]) {\n  if (!/^[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}$/.test(v)) throw new Error(`Invalid version: ${v}`);\n}\nif (oldV === newV) throw new Error('old_version and new_version are the same');\nreturn [{ json: { product, old_version: oldV, new_version: newV, trigger, requested_at: new Date().toISOString() } }];\n"
      },
      "id": "ee9500b1-7c05-444a-90e3-29e19a64d0a3",
      "name": "Start Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        336
      ]
    },
    {
      "parameters": {
        "authentication": "n8nUserAuth",
        "formTitle": "Patch diff: run one product",
        "formDescription": "Diffs two versions of a product already defined in pd_watch. Artefacts are fetched (or taken from the product inbox) by the pipeline.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Product",
              "fieldName": "product",
              "placeholder": "openssh",
              "requiredField": true
            },
            {
              "fieldLabel": "Old version",
              "fieldName": "old_version",
              "placeholder": "9.8p1",
              "requiredField": true
            },
            {
              "fieldLabel": "New version",
              "fieldName": "new_version",
              "placeholder": "9.9p1",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "path": "pd-run",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Run started. Results land in #n8n-alerts and the pd_runs table."
            }
          }
        }
      },
      "id": "b3bca6df-560c-4d76-861a-9dc983580be0",
      "name": "Run Diff",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,

      },
      "id": "2087c777-c6b8-417e-bdb2-7f937ae593c3",
      "name": "Get Watch Row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        512,
        336
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const req = $('Start Request').first().json;\nconst row = $input.all().map((i) => i.json).find((r) => r && r.product === req.product);\nif (!row) throw new Error(`No pd_watch row for ${req.product}`);\nlet options = {};\ntry { options = row.options ? JSON.parse(row.options) : {}; } catch (e) { throw new Error(`pd_watch.options for ${req.product} is not valid JSON`); }\nconst KINDS = ['source', 'elf', 'pe', 'macho', 'jar', 'dotnet', 'firmware', 'msi', 'deb', 'rpm'];\nif (!KINDS.includes(row.artefact_kind)) throw new Error(`Unknown artefact_kind ${row.artefact_kind} for ${req.product}`);\nconst stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\nconst rand = Math.floor(Math.random() * 0x10000).toString(16).padStart(4, '0');\nconst run_id = `${stamp}-${rand}`;\nconst base = `/opt/loot/patchdiff/${req.product}`;\nconst run_dir = `${base}/${run_id}`;\nconst clamp = (v, lo, hi, d) => Math.min(Math.max(parseInt(v ?? d, 10) || d, lo), hi);\nconst limits = {\n  fetch: clamp(options.fetch_max_minutes, 5, 240, 60),\n  unpack: clamp(options.unpack_max_minutes, 5, 480, 90),\n  diff: clamp(options.diff_max_minutes, 10, 720, 240),\n  advisory: 20,\n  triage: clamp(options.triage_max_minutes, 5, 240, 60)\n};\nconst { id, createdAt, updatedAt, options: _raw, ...watch } = row;\nconst config = { ...options, ...watch, product: req.product, old_version: req.old_version, new_version: req.new_version, run_id, created_at: new Date().toISOString() };\nconst cfg_b64 = Buffer.from(JSON.stringify(config, null, 2), 'utf8').toString('base64');\nconst bundle = [\n  'set -euo pipefail',\n  'umask 027',\n  `B='${base}'; R='${run_dir}'`,\n  'mkdir -p \"$B\"',\n  'if ! mkdir \"$B/.lock\" 2>/dev/null; then',\n  '  if [ -n \"$(find \"$B/.lock\" -maxdepth 0 -mmin +960 2>/dev/null)\" ]; then rmdir \"$B/.lock\"; mkdir \"$B/.lock\"; else echo \\'{\"locked\":true}\\'; exit 0; fi',\n  'fi',\n  'mkdir -p \"$R\"',\n  `printf '%s' '${cfg_b64}' | base64 -d > \"$R/config.json\"`,\n  'echo \\'{\"locked\":false}\\''\n].join('\\n');\nreturn [{ json: { ...req, run_id, run_dir, options, limits, started_at: new Date().toISOString(), bundle_b64: Buffer.from(bundle, 'utf8').toString('base64') } }];\n"
      },
      "id": "410604c6-8b82-49f9-b291-744e78ab78e8",

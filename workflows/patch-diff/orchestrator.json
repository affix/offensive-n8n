    {
      "parameters": {
        "jsCode": "const ctx = $('Run Context').first().json;\nconst j = $input.first().json;\nconst ORDER = ['fetch', 'unpack', 'diff', 'advisory', 'triage', 'alerts'];\nconst stages = j.stages ?? {};\nconst errRaw = j.error ?? null;\nconst failed = errRaw !== null && errRaw !== undefined;\nconst errMsg = failed ? String(errRaw.message ?? errRaw.description ?? errRaw).replace(/\\s*\\[line \\d+\\]$/, '').slice(0, 900) : '';\nconst failedStage = failed ? (ORDER.find((k) => !stages[k]) ?? 'unknown') : null;\nconst timedOut = Object.entries(stages).filter(([, s]) => s && s.timed_out).map(([k]) => k);\nconst finished = new Date();\nconst mins = Math.round((finished - new Date(ctx.started_at)) / 60000);\nconst a = stages.alerts ?? {};\nconst fetchNew = stages.fetch?.new ?? {};\nconst code = (s) => '`' + String(s).replace(/`/g, \"'\") + '`';\nconst fields = [\n  { name: 'Versions', value: `${ctx.old_version} → ${ctx.new_version}`, inline: true },\n  { name: 'Trigger', value: String(ctx.trigger), inline: true },\n  { name: 'Duration', value: `${mins} min`, inline: true }\n];\nif (timedOut.length) fields.push({ name: 'Timed out (partial results)', value: timedOut.join(', ') });\nconst warn = Object.entries(stages).flatMap(([k, s]) => (s?.warnings ?? []).slice(0, 3).map((w) => `${k}: ${w}`));\nif (warn.length) fields.push({ name: 'Warnings', value: warn.slice(0, 8).join('\\n').slice(0, 1024) });\nif (failed) fields.push({ name: `Failed at ${failedStage}`, value: ('```\\n' + errMsg + '\\n```').slice(0, 1024) });\nfields.push({ name: 'Run dir', value: code(ctx.run_dir) });\nconst status = failed ? 'failed' : (timedOut.length ? 'partial' : 'ok');\nreturn [{ json: {\n  run_id: ctx.run_id, product: ctx.product, old_version: ctx.old_version, new_version: ctx.new_version,\n  status, stage: failed ? failedStage : 'done', finished_at: finished.toISOString(),\n  candidates: a.candidates ?? stages.diff?.candidates ?? 0, silent_fixes: a.silent_fixes ?? 0, error: errMsg,\n  version_status: failed ? 'failed' : 'diffed', artefact_path: fetchNew.path ?? stages.fetch?.repo ?? '', sha256: fetchNew.sha256 ?? stages.fetch?.new?.commit ?? '',\n  notify: failed || timedOut.length > 0,\n  embed: { title: `${failed ? '❌' : '⚠️'} Patch diff run · ${ctx.product}`, color: failed ? 0x9B111E : 0xE67E22, fields, footer: { text: `PD · ${ctx.run_id}` }, timestamp: finished.toISOString() }\n} }];\n"
      },

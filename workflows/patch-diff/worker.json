    {
      "parameters": {
        "jsCode": "const p = $('Plan').first().json;\nconst pub = String($('Make Key').first().json.stdout ?? '').trim();\nif (!/^ssh-ed25519 [A-Za-z0-9+/=]+ pd-/.test(pub)) throw new Error('Run key was not generated');\nconst ip = String($('Pi Public IP').first().json.ip ?? '');\nif (!/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(ip)) throw new Error(`Could not resolve the Pi's public IPv4 (${ip})`);\nconst snaps = ($('List Snapshots').first().json.snapshots ?? [])\n  .filter((s) => String(s.name).startsWith(p.snapshot_prefix))\n  .sort((a, b) => (a.created_at < b.created_at ? 1 : -1));\nif (!snaps.length) throw new Error(`No ${p.snapshot_prefix}* snapshot; build one with pd-worker.yml`);\nconst snap = snaps[0];\nconst region = p.region || snap.regions[0];\nif (!snap.regions.includes(region)) throw new Error(`Snapshot ${snap.name} is not in ${region} (has ${snap.regions.join(', ')})`);\nconst fw = ($('List Firewalls').first().json.firewalls ?? []).find((f) => f.name === 'pd-worker');\nif (!fw) throw new Error('DO firewall pd-worker is missing; run the worker setup');\nconst key = ($('List Keys').first().json.ssh_keys ?? []).find((k) => k.name === 'pd-worker-bootstrap');\nif (!key) throw new Error('DO SSH key pd-worker-bootstrap is missing; run the worker setup');\nconst user_data = ['#cloud-config', 'ssh_authorized_keys:', `  - ${pub}`, ''].join('\\n');\nconst firewall_body = {\n  name: fw.name, tags: ['pd-worker'], droplet_ids: [],\n  inbound_rules: [{ protocol: 'tcp', ports: '22', sources: { addresses: [`${ip}/32`] } }],\n  outbound_rules: fw.outbound_rules\n};\nconst droplet_body = {\n  name: p.name, region, size: p.size, image: Number(snap.id), ssh_keys: [key.id],\n  tags: ['pd-worker', p.tag], user_data, ipv6: false, monitoring: false\n};\nreturn [{ json: { firewall_id: fw.id, firewall_body, droplet_body, snapshot: snap.name, region, pi_ip: ip } }];\n"
      },

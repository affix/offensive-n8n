        "jsCode": "const p = $('Plan').first().json;\nconst host = JSON.parse($input.first().json.stdout).host;\nconst spec = $('Droplet Spec').first().json;\nconst d = $('Create Droplet').first().json.droplet ?? {};\nreturn [{ json: { ...p.ctx, remote_host: host, worker: { droplet_id: d.id, name: d.name, size: spec.droplet_body.size, region: spec.region, snapshot: spec.snapshot } } }];\n"
      },

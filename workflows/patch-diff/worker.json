        "command": "=K='{{ $json.key_dir }}'\ncase \"$K\" in /dev/shm/pd-ssh/[0-9]*) ;; *) echo 'bad key dir' >&2; exit 1;; esac\numask 077\nmkdir -p \"$K\"\nrm -f \"$K/id\" \"$K/id.pub\" \"$K/known_hosts\"\nssh-keygen -q -t ed25519 -N '' -C 'pd-{{ $json.run_id }}' -f \"$K/id\"\ncat \"$K/id.pub\""
      },

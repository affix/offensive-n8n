      "parameters": {
        "jsCode": "const p = $('Plan').first().json;\nconst del = $('Delete Droplet').first().json;\nconst failed = Boolean(del && del.error);\nconst embed = failed ? {\n  title: `⚠️ PD worker teardown failed · ${p.ctx.product}`,\n  color: 0xE67E22,\n  description: `Could not delete droplets tagged \\`${p.tag}\\`. The hourly reaper will retry; check DigitalOcean if it persists.\\n\\`\\`\\`\\n${String(del.error.message ?? del.error).slice(0, 600)}\\n\\`\\`\\``,\n  footer: { text: `PD · Worker · ${p.run_id}` }, timestamp: new Date().toISOString()\n} : null;\nreturn [{ json: { ...p.ctx, worker_torn_down: !failed, notify: failed, embed } }];\n"
      },

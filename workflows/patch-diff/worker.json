{
  "id": "znR5VjAmOSkzkEXm",
  "name": "PD · Worker",
  "description": "On-demand DigitalOcean worker for PD runs with options.remote: brings up a droplet from the latest pd-worker-* snapshot, pulls results back, tears it down; hourly reaper for stragglers.",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "op"
            },
            {
              "name": "ctx",
              "type": "object"
            }
          ]
        }
      },
      "id": "953ab50b-73aa-44b5-ab87-5ef9e3ecdf89",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const PROJECT_ID = 'DO_PROJECT_ID';\nconst first = $input.first().json;\nconst op = 'op' in first ? String(first.op ?? '') : 'reap';\nif (!['up', 'pull', 'down', 'reap'].includes(op)) throw new Error(`Unknown worker op: ${op}`);\nif (op === 'reap') return [{ json: { op, route: 'reap', max_age_hours: 24 } }];\nconst ctx = typeof first.ctx === 'string' ? JSON.parse(first.ctx) : (first.ctx ?? {});\nconst opts = ctx.options ?? {};\nconst remote = opts.remote === true || opts.remote === 'true';\nconst run_id = String(ctx.run_id ?? '');\nif (!/^\\d{8}T\\d{6}Z-[0-9a-f]{4}$/.test(run_id)) throw new Error(`Bad run_id: ${run_id}`);\nconst run_dir = String(ctx.run_dir ?? '');\nif (!/^\\/opt\\/loot\\/patchdiff\\/[a-z0-9][a-z0-9_-]{0,39}\\/\\d{8}T\\d{6}Z-[0-9a-f]{4}$/.test(run_dir)) throw new Error(`Bad run_dir: ${run_dir}`);\nconst size = String(opts.do_size ?? 'c-8');\nconst region = String(opts.do_region ?? '');\nif (!/^[a-z0-9-]{2,40}$/.test(size) || (region && !/^[a-z0-9]{3,8}$/.test(region))) throw new Error('Bad do_size or do_region in options');\nconst remote_host = String(ctx.remote_host ?? '');\nif (remote_host && !/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(remote_host)) throw new Error(`Bad remote_host: ${remote_host}`);\nreturn [{ json: {\n  op, route: remote ? op : 'local', ctx, run_id, run_dir, remote_host,\n  tag: `pd-run-${run_id}`, name: `pd-${run_id.toLowerCase()}`, key_dir: `/dev/shm/pd-ssh/${run_id}`,\n  size, region, snapshot_prefix: 'pd-worker-', project_id: PROJECT_ID\n} }];\n"
      },

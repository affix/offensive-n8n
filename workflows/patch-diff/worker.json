    {
      "parameters": {
        "command": "=PD_SH=$(cat <<'PD_SH_EOF'\nK='{{ $('Plan').first().json.key_dir }}'\nR='{{ $('Plan').first().json.run_dir }}'\nH='{{ $json.droplet.networks.v4.filter(n => n.type === \"public\").map(n => n.ip_address)[0] }}'\ncase \"$H\" in *[!0-9.]*|'') echo \"bad worker address $H\" >&2; exit 1;; esac\nO=(-i \"$K/id\" -o UserKnownHostsFile=\"$K/known_hosts\" -o BatchMode=yes -o ConnectTimeout=10)\n# First contact pins the host key (per-run known_hosts in RAM); everything after is strict.\nok=0\nfor i in $(seq 1 45); do\n  if ssh \"${O[@]}\" -o StrictHostKeyChecking=accept-new root@\"$H\" true 2>/dev/null; then ok=1; break; fi\n  sleep 8\ndone\n[ \"$ok\" = 1 ] || { echo \"worker $H never accepted SSH\" >&2; exit 1; }\nssh \"${O[@]}\" -o StrictHostKeyChecking=yes root@\"$H\" 'cloud-init status --wait >/dev/null 2>&1; test -x /opt/patchdiff/bin/pd' || { echo \"worker $H has no /opt/patchdiff/bin/pd\" >&2; exit 1; }\n# Stage scripts follow the Pi, so the snapshot only needs rebuilding for tool or dependency changes.\nset -o pipefail\ntar -C /opt/patchdiff/bin -cf - --exclude=__pycache__ . | ssh \"${O[@]}\" -o StrictHostKeyChecking=yes root@\"$H\" 'tar -C /opt/patchdiff/bin -xf - --no-same-owner && chown -R root:root /opt/patchdiff/bin' || { echo \"could not sync /opt/patchdiff/bin to $H\" >&2; exit 1; }\nssh \"${O[@]}\" -o StrictHostKeyChecking=yes root@\"$H\" \"runuser -u n8n -- bash -c 'umask 027; mkdir -p \\\"$R\\\" && cat > \\\"$R/config.json\\\"'\" < \"$R/config.json\"\nprintf '{\"host\":\"%s\"}\\n' \"$H\"\nPD_SH_EOF\n)\nexec bash -c \"$PD_SH\""
      },
      "id": "8c51976d-a1c3-4fcb-a20a-b10fd5ee603c",
      "name": "Connect Worker",

      "id": "a4bc949b-d287-4967-a51c-2903ec2a5159",
      "name": "Retry Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3088,
        400
      ]
    },
    {
      "parameters": {
        "command": "=PD_SH=$(cat <<'PD_SH_EOF'\nK='{{ $json.key_dir }}'\nR='{{ $json.run_dir }}'\nH='{{ $json.remote_host }}'\ncase \"$H\" in *[!0-9.]*|'') echo \"bad worker address $H\" >&2; exit 1;; esac\numask 027\nset -o pipefail\n# Results only: decompiled trees and unpacked artefacts stay on the worker and die with it.\nssh -i \"$K/id\" -o UserKnownHostsFile=\"$K/known_hosts\" -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20 root@\"$H\" \\\n  \"runuser -u n8n -- tar -C '$R' -cf - --exclude=unpack/src --exclude=unpack/unpacked --exclude=job.sh fetch unpack diff\" \\\n  | tar -C \"$R\" -xf - --no-same-owner --no-same-permissions\ndu -sk \"$R\" | awk '{printf \"{\\\"pulled_kb\\\":%s}\\n\", $1}'\nPD_SH_EOF\n)\nexec bash -c \"$PD_SH\""
      },

{
  "id": "PpGzaQp9DxQSRshR",
  "name": "PD · Error Handler",
  "description": "Error workflow for the PD pipeline: posts failed executions to #n8n-alerts.",
  "active": true,
  "nodes": [
    {
      "id": "7ef13696-4b18-4051-b97c-f84d4841362d",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "32a0da68-76d6-4ec8-a8df-cc7f24a83aac",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nconst cut = (s, n) => { s = String(s ?? ''); return s.length > n ? s.slice(0, n - 1) + '…' : s; };\nconst ex = j.execution ?? {};\nconst err = ex.error ?? {};\nconst wf = j.workflow ?? {};\nreturn [{ json: { embed: {\n  title: cut(`💥 ${wf.name ?? 'Workflow'} failed`, 256),\n  url: ex.url || undefined,\n  color: 0x9B111E,\n  description: cut('```\\n' + (err.message ?? 'no message') + '\\n```', 2000),\n  fields: [\n    { name: 'Failed node', value: cut(ex.lastNodeExecuted ?? 'unknown', 256), inline: true },\n    { name: 'Mode', value: cut(ex.mode ?? 'unknown', 64), inline: true },\n    { name: 'Execution', value: cut(String(ex.id ?? 'n/a'), 64), inline: true }\n  ],\n  footer: { text: 'PD · Error Handler' },\n  timestamp: new Date().toISOString()\n} } }];\n"
      }
    },
    {
      "id": "e3db1e7e-5a4f-4bf4-a24a-5e9864b49dd8",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "authentication": "botToken",
        "guildId": {
          "__rl": true,
          "value": "DISCORD_GUILD_ID",
          "mode": "list",
          "cachedResultName": "Alerts"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "value": "DISCORD_ALERTS_CHANNEL_ID",
          "mode": "list",
          "cachedResultName": "n8n-alerts"
        },
        "options": {},
        "embeds": {
          "values": [
            {
              "inputMethod": "json",
              "json": "={{ JSON.stringify($json.embed) }}"
            }
          ]
        }
      },
      "credentials": {
        "discordBotApi": {
          "id": "CREDENTIAL_ID",
          "name": "Discord Bot account"
        }
      },
      "webhookId": "e39bbcdb-47ac-4ef8-bdd6-e12a8e3927cd"
    }
  ],

    {
      "id": "5907f889-16a4-4c4e-90f3-50005a1bfd35",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst res = r.result ?? {};\nconst issues = [...(res.issues ?? [])];\nif (r.timed_out) issues.push('housekeeping timed out (partial)');\nconst now = new Date();\nconst monday = now.getUTCDay() === 1;\nconst trig = $('Run Now').isExecuted ? 'manual' : 'schedule';\nconst products = Object.entries(res.products ?? {});\nconst disk = res.disk ?? {};\nconst lines = products.slice(0, 15).map(([p, s]) => `\\`${p}\\` runs ${s.runs} · cache ${s.cache_mb}MB · ghidra ${s.ghidra_mb}MB · compressed ${s.compressed}${s.cache_pruned?.length ? ` · pruned ${s.cache_pruned.join(', ')}` : ''}`);\nconst embed = {\n  title: issues.length ? '⚠️ PD housekeeping: issues' : '🧹 PD housekeeping weekly summary',\n  color: issues.length ? 0xE67E22 : 0x2ECC71,\n  description: (lines.join('\\n') || 'No products yet.').slice(0, 3500),\n  fields: [\n    { name: 'Disk free', value: `${disk.free_gb ?? '–'}GB (${disk.free_pct ?? '–'}%)`, inline: true },\n    { name: 'Patch diff loot', value: `${res.pd_root_mb ?? '–'}MB`, inline: true },\n    { name: 'Locks cleared', value: String((res.locks_cleared ?? []).length), inline: true }\n  ],\n  footer: { text: 'PD · Housekeeping' },\n  timestamp: now.toISOString()\n};\nif (issues.length) embed.fields.push({ name: 'Issues', value: issues.slice(0, 10).join('\\n').slice(0, 1024) });\nreturn [{ json: { notify: issues.length > 0 || monday || trig === 'manual', embed } }];\n"
      }
    },

      "name": "Build Housekeeping Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\nconst rand = Math.floor(Math.random() * 0x10000).toString(16).padStart(4, '0');\nconst job_dir = `/opt/loot/patchdiff/pd-sys/${stamp}-${rand}/housekeeping`;\nconst script = [\n  '#!/usr/bin/env bash',\n  'set -euo pipefail',\n  `exec /opt/patchdiff/bin/pd housekeeping --job-dir '${job_dir}' --keep-days 14 --keep-runs 3 --min-free-gb 10`,\n  ''\n].join('\\n');\nreturn [{ json: { job_dir, script, max_minutes: 120 } }];\n"
      }
    },

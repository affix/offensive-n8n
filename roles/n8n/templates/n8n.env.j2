# Managed by Ansible. Environment for the n8n systemd service.

# Listen on the LAN bind IP ONLY, never 0.0.0.0.
N8N_LISTEN_ADDRESS={{ n8n_bind_ip }}
N8N_PORT={{ n8n_port }}

# Public identity is the external nginx front door (TLS); on-box Caddy and the
# remote nginx proxy to the listener above.
N8N_HOST={{ n8n_public_host }}
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL={{ n8n_public_url }}
WEBHOOK_URL={{ n8n_public_url }}
# One proxy hop in front: trust its X-Forwarded-* headers.
N8N_PROXY_HOPS=1
# Required for login to work over plain HTTP off loopback.
N8N_SECURE_COOKIE=false

# State lives under {{ n8n_data_dir }} (sqlite DB, credentials, encryption key).
N8N_USER_FOLDER={{ n8n_dir }}
# N8N_ENCRYPTION_KEY is intentionally UNSET: n8n generates its own key into
# {{ n8n_data_dir }}/config on first boot and persists it there.

# n8n 2.x excludes Execute Command / Read-Write Files / Local File Trigger by
# default. Empty list = all nodes available. Host command access is the point.
NODES_EXCLUDE={{ n8n_nodes_exclude }}
# Read/Write Files node may only touch the loot tree.
N8N_RESTRICT_FILE_ACCESS_TO={{ loot_dir }}
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true

N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

GENERIC_TIMEZONE={{ timezone }}
TZ={{ timezone }}
NODE_ENV=production
